<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vestiaire_background">

    <!-- AREA KONTEN FORM INPUT (Bisa di-scroll) -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="90dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Judul Halaman -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="24dp"
                android:text="Add New Clothing"
                android:textAlignment="center"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/vestiaire_text" />

            <!-- Preview Gambar -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="250dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#E0E0E0"
                app:cardBackgroundColor="@color/vestiaire_surface">

                <ImageView
                    android:id="@+id/ivPreview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#F5F5F5"
                    android:scaleType="centerCrop"
                    android:src="@android:drawable/ic_menu_camera" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Tombol Pilih Gambar -->
            <Button
                android:id="@+id/btnSelectImage"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:text="Select Image"
                android:textColor="@color/vestiaire_primary"
                app:iconTint="@color/vestiaire_primary"
                app:backgroundTint="@color/vestiaire_surface"
                app:icon="@android:drawable/ic_menu_gallery" />

            <!-- Input Nama Clothing -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:hint="Clothing Name (e.g. Black Jacket)"
                app:startIconDrawable="@android:drawable/ic_menu_agenda"
                app:startIconTint="@color/vestiaire_subtext"
                app:hintTextColor="@color/vestiaire_primary"
                app:boxStrokeColor="@color/vestiaire_primary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/vestiaire_text"
                    android:textColorHint="@color/vestiaire_subtext"
                    android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Input Warna Clothing -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="Color (e.g. Black, Red)"
                app:startIconDrawable="@android:drawable/ic_menu_manage"
                app:startIconTint="@color/vestiaire_subtext"
                app:hintTextColor="@color/vestiaire_primary"
                app:boxStrokeColor="@color/vestiaire_primary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etColor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/vestiaire_text"
                    android:textColorHint="@color/vestiaire_subtext"
                    android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Pengaturan Kategori -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Category"
                android:textColor="@color/vestiaire_subtext"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinnerCategory"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@android:drawable/btn_dropdown" />

            <!-- Pengaturan Occassion -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Occasion"
                android:textColor="@color/vestiaire_subtext"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinnerOccasion"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@android:drawable/btn_dropdown" />

            <!-- Loading Progress Bar -->
            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="24dp"
                android:indeterminateTint="@color/vestiaire_secondary"
                android:visibility="gone" />

            <!-- Tombol Simpan Utama -->
            <Button
                android:id="@+id/btnSave"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="32dp"
                android:text="Save Clothing"
                android:textSize="16sp"
                android:textStyle="bold"
                android:backgroundTint="@color/vestiaire_primary"
                android:textColor="@color/vestiaire_surface" />

        </LinearLayout>
    </ScrollView>

    <include
        layout="@layout/layout_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_gravity="bottom" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>