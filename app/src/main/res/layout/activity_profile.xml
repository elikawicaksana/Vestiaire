<?xml version="1.0" encoding="utf-8"?>

<!-- Root Layout yang memungkinkan koordinasi dengan komponen seperti Bottom Navigation -->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vestiaire_background">

    <!-- ConstraintLayout sebagai container utama -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- ScrollView agar seluruh halaman dapat di-scroll -->
        <ScrollView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:fillViewport="true"
            android:clipToPadding="false"
            android:paddingBottom="90dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Container utama seluruh isi halaman -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- ================= HEADER ================= -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">

                    <!-- Bagian sapaan dan nama pengguna -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_alignParentStart="true"
                        android:layout_toStartOf="@id/layoutClothingCount"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="16dp">

                        <!-- Sapaan -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Hello,"
                            android:textColor="@color/vestiaire_subtext"
                            android:textSize="15sp" />

                        <!-- Nama pengguna (diisi dari Firebase) -->
                        <TextView
                            android:id="@+id/tvName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            tools:text="Username"
                            android:textStyle="bold"
                            android:textColor="@color/vestiaire_text"
                            android:textSize="26sp"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:maxLines="1" />

                        <!-- Subtitle -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Manage your wardrobe"
                            android:textColor="@color/vestiaire_subtext"
                            android:textSize="13sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <!-- Card jumlah pakaian -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/layoutClothingCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp"
                        app:cardBackgroundColor="#0D000000">

                        <!-- Isi card -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="10dp"
                            android:minWidth="80dp">

                            <!-- Label -->
                            <TextView
                                android:id="@+id/tvClothingLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="CLOTHING"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:textColor="@color/vestiaire_subtext"
                                android:letterSpacing="0.05" />

                            <!-- Jumlah pakaian -->
                            <TextView
                                android:id="@+id/tvClothingCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textSize="22sp"
                                android:textStyle="bold"
                                android:textColor="@color/vestiaire_text"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </RelativeLayout>

                <!-- ================= PROFILE CARD ================= -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    app:cardBackgroundColor="@color/vestiaire_surface"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="3dp">

                    <!-- Isi Profile Card -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="24dp">

                        <!-- Judul -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Profile Information"
                            android:textStyle="bold"
                            android:textSize="18sp"
                            android:textColor="@color/vestiaire_text" />

                        <!-- Input Username -->
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            app:startIconDrawable="@android:drawable/ic_menu_myplaces">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etUsername"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Username"
                                android:textColor="@color/vestiaire_text"
                                android:textColorHint="@color/vestiaire_subtext" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Input Email -->
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            app:startIconDrawable="@android:drawable/ic_dialog_email">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etEmail"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textEmailAddress"
                                android:hint="Email"
                                android:textColor="@color/vestiaire_text"
                                android:textColorHint="@color/vestiaire_subtext" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Input Password Baru -->
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            app:startIconDrawable="@android:drawable/ic_lock_lock"
                            app:passwordToggleEnabled="true"
                            app:passwordToggleTint="@color/vestiaire_subtext">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etPassword"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textPassword"
                                android:hint="New Password"
                                android:textColor="@color/vestiaire_text"
                                android:textColorHint="@color/vestiaire_subtext" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Tombol menyimpan perubahan profil -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnUpdate"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:layout_marginTop="24dp"
                            android:text="Save Changes"
                            android:textAllCaps="false"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:backgroundTint="@color/vestiaire_primary"
                            android:textColor="@color/vestiaire_surface"
                            app:iconTint="@color/vestiaire_surface"
                            app:cornerRadius="16dp"
                            app:icon="@android:drawable/ic_menu_save"
                            app:iconGravity="textStart" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ================= LOGOUT ================= -->
                <!-- Tombol logout akun -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLogout"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="16dp"
                    android:text="Logout"
                    android:textAllCaps="false"
                    android:textColor="@color/vestiaire_error"
                    app:cornerRadius="16dp"
                    app:strokeColor="@color/vestiaire_error"
                    app:strokeWidth="1dp"
                    app:iconTint="@color/vestiaire_error" />
            </LinearLayout>
        </ScrollView>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Bottom Navigation yang digunakan di seluruh aplikasi -->
    <include
        layout="@layout/layout_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_gravity="bottom" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>